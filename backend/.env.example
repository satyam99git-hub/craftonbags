# ─────────────────────────────────────────────────────────────
# Crafton Bags — Backend Environment Variables
# Copy this file to backend/.env and fill in your values.
#   cp backend/.env.example backend/.env
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
PORT=5000

# ── Database ──────────────────────────────────────────────────
# Local MongoDB:  mongodb://127.0.0.1:27017/craftonbags
# MongoDB Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/craftonbags
MONGO_URI=mongodb://127.0.0.1:27017/craftonbags

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Cloudinary (image uploads) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Email / SMTP ──────────────────────────────────────────────
# Gmail example: use an App Password, not your regular password.
# Mailtrap (dev/test): https://mailtrap.io
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ── Razorpay (payments) ───────────────────────────────────────
# Use test-mode keys from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
