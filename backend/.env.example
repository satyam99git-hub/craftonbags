PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/craftonbags
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

# Firebase Admin SDK - use either the JSON string or the split values below.
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Transactional email - Gmail SMTP example
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
MAIL_FROM_NAME=Crafton Bags
MAIL_FROM_EMAIL=your-email@gmail.com
MAIL_REPLY_TO=support@craftonbags.com

# Resend SMTP alternative
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxx
# MAIL_FROM_EMAIL=hello@your-verified-domain.com
